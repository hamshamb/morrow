{
  "name": "ai-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first desktop AI workspace: one workspace, any model, any tool, shared context.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @ai-workspace/desktop dev",
    "build": "pnpm --filter @ai-workspace/desktop build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.4.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.2"
  }
}
